# Системные файлы macOS, Windows и редакторов.
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
__MACOSX/
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

__pycache__/
*.pyc

# Служебные файлы wrangler и локальные секреты воркера (токен бота).
.wrangler/
.dev.vars

# Локальные секреты скриптов: токен Яндекс Диска (YANDEX_DISK_TOKEN).
.env

# Исходные файлы источников (кэш scripts/fetch_data.py) — только локально,
# в git идёт нормализованный data/vocab/.
data/raw/

# Учебники и материалы (PDF, docx, картинки) — только локально, позже
# переедут на Яндекс Диск. В library в git попадают только HTML-страницы
# сайта.
library/**
!library/**/
!library/**/*.html
# Упражнения «Практики говорения» — картинки в тексте страницы, а не файлы
# для скачивания: на Диск их не перенести, поэтому они идут в git.
!library/practice/speaking-*.jpg
!library/practice/speaking-*.png

# Обложки материалов (собирает scripts/make_previews.py) — только локально.
# Без них страницы показывают плашку с расширением файла (js/main.js).
images/previews/
